      "text": "evaluate_product\n  └─ extract\n       extract.raw.*\n       extract.structured.*\n       → GENERATION (gemini)\n  └─ match\n       └─ match.layer_a\n       └─ match.layer_b\n           ↳ tool.pubchem.name\n           ↳ tool.pubchem.formula\n       └─ match.layer_c\n           ↳ GENERATION (gemini)",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "evaluate_product\n  └─ extract\n       extract.raw.*\n       extract.structured.*\n       → GENERATION (gemini)\n  └─ match\n       └─ match.layer_a\n       └─ match.layer_b\n           ↳ tool.pubchem.name\n           ↳ tool.pubchem.formula\n       └─ match.layer_c\n           ↳ GENERATION (gemini)",
      "lineHeight": 1.25,
      "autoResize": true
    },
